[Term]
id: GO:0038028
name: insulin receptor signaling pathway via phosphatidylinositol 3-kinase
namespace: biological_process
def: "An insulin receptor signaling pathway in which the signal is transmitted via the phosphatidylinositol 3-kinase cascade." [GOC:bf, GOC:signaling, PMID:19322168, PMID:20696212]
is_a: GO:0008286 ! insulin receptor signaling pathway
relationship: has_part GO:0014065 ! phosphatidylinositol 3-kinase signaling

[Term]
id: GO:0038029
name: epidermal growth factor receptor signaling pathway via MAPK cascade
namespace: biological_process
