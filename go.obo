[Term]
id: GO:0075341
name: host cell PML body
namespace: cellular_component
def: "A nuclear body that reacts against SP100 auto-antibodies (PML = promyelocytic leukemia) located within a cell of a host organism." [GOC:BHF, GOC:jl]
