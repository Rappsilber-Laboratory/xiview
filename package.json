{
  "name": "xiview",
  "version": "2.0.2a2",
  "description": "visualisation of crosslinking  mass spectrometry data",
  "keywords": [
    "xiVIEW",
    "crosslinking",
    "mass spectrometry",
    "protein",
    "interactions"
  ],
  "bugs": {
    "url": "https://github.com/Rappsilber-Laboratory/xiview/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:Rappsilber-Laboratory/xiview.git"
  },
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Colin Combe",
    "email": "colin.combe@ed.ac.uk"
  },
  "contributors": [
    {
      "name": "Martin Graham",
      "email": "M.Graham@napier.ac.uk"
    },
    {
      "name": "Colin Combe",
      "email": "colin.combe@ed.ac.uk"
    },
    {
      "name": "Lars Kolbowski",
      "email": "lars.kolbowski@tu-berlin.de"
    },
    {
      "name": "Lutz Fischer",
      "email": "lutz.fischer@tu-berlin.de"
    }
  ],
  "main": "./js/main.js",
  "scripts": {
    "lint": "eslint js",
    "lint:css": "stylelint \"css/**/*.css\"",
    "lint:css-fix": "stylelint \"css/**/*.css\" --fix",
    "test": "node scripts/run-tests.js",
    "build-dev": "rm -rf dist && webpack --mode development --config webpack.dev.js;",
    "build-prod": "rm -rf dist && webpack --mode production --config webpack.prod.js;",
    "copy-to-xiview-server": "find dist/ -maxdepth 1 -type f ! -name 'tests_*' -exec cp {} ../xiview-server/static/ \\; ;",
    "build-dev-and-copy-to-xiview-server": "npm run build-dev && npm run copy-to-xiview-server;",
    "build-prod-and-copy-to-xiview-server": "rm -rf dist && npm run build-prod && npm run copy-to-xiview-server;",
    "all-dev": "npm run lint && npm run build-dev && npm run test && npm run copy-to-xiview-server;",
    "prepare": "(python3 -m pre_commit --version > /dev/null 2>&1 || pip3 install --user pre-commit 2>/dev/null || pip3 install --break-system-packages pre-commit 2>/dev/null || pip3 install pre-commit) && python3 -m pre_commit install && python3 -m pre_commit install --hook-type pre-push"
  },
  "dependencies": {
    "@eastdesire/jscolor": "~2.5.2",
    "backbone": "~1.6.0",
    "colorbrewer": "~1.6.0",
    "core-js": "~3.48.0",
    "d3": "~3.5.17",
    "datatables.net": "~2.3.7",
    "datatables.net-dt": "~1.13.10",
    "jquery": "~3.7.1",
    "jquery-ui": "~1.14.1",
    "json-formatter-js": "^2.5.23",
    "jsonview": "~1.2.0",
    "ngl": "~2.4.0",
    "path-browserify": "^1.0.1",
    "plotly.js-basic-dist-min": "~3.5.0",
    "spin": "~0.0.1",
    "split.js": "~1.6.4",
    "sprintf-js": "~1.1.3",
    "underscore": "~1.13.1",
    "webcola": "^3.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.21.5",
    "@babel/parser": "^7.28.5",
    "@babel/preset-env": "^7.21.5",
    "babel-loader": "^9.1.2",
    "css-loader": "^7.1.4",
    "eslint": "^10.0.0",
    "globals": "^17.3.0",
    "jsdom": "^26.1.0",
    "puppeteer": "^24.0.0",
    "qunit": "2.21.1",
    "style-loader": "^3.3.2",
    "stylelint": "^17.4.0",
    "stylelint-config-standard": "^40.0.0",
    "webpack": "^5.104.1",
    "webpack-cli": "^5.0.2",
    "webpack-merge": "^5.8.0",
    "xml2js": "^0.6.2",
    "xmlbuilder2": "^4.0.0"
  },
  "engines": {
    "node": ">=24.13.1"
  }
}
